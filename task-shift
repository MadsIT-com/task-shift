    def current_scope(self) -> str:
        return str(self.scope.currentData())

    def selected(self) -> TimerUnit | None:
        row = self.table.currentRow()
        if row < 0:
            return None
        item = self.table.item(row, 0)
        timer = item.data(Qt.ItemDataRole.UserRole) if item else None
        return timer if isinstance(timer, TimerUnit) else None

    def set_busy(self, message: str) -> None:
        self.status.setText(message)
        self.progress.show()
        self.refresh_button.setEnabled(False)
        self.scope.setEnabled(False)
        for button in self.action_buttons.values():
            button.setEnabled(False)
        self.edit_schedule_button.setEnabled(False)
        self.restore_schedule_button.setEnabled(False)

    def clear_busy(self, message: str) -> None:
        self.status.setText(message)
        self.progress.hide()
        self.refresh_button.setEnabled(True)
        self.scope.setEnabled(True)
        self.update_selection()

    def start_job(
        self,
        function: Callable[..., object],
        arguments: tuple[object, ...],
        message: str,
        on_success: Callable[[object], None],
    ) -> None:
        if self.job is not None and self.job.isRunning():
            return
        self.set_busy(message)
        job = BackgroundJob(function, *arguments)
        self.job = job

        def finished() -> None:
            self.job = None
            if job.error:
                self.clear_busy("The operation did not complete")
                QMessageBox.critical(self, TITLE, job.error)
            else:
                on_success(job.result)
            job.deleteLater()

        job.finished.connect(finished)
        job.start()

    def refresh(self) -> None:
        scope = self.current_scope()
        self.start_job(
            load_timers,
            (scope,),
            f"Loading {scope} timers…",
            self.timers_loaded,
        )

    def timers_loaded(self, result: object) -> None:
        assert isinstance(result, list)
        self.timers = result
        self.table.setSortingEnabled(False)
        self.table.setRowCount(len(self.timers))
        for row, timer in enumerate(self.timers):
            name = QTableWidgetItem(timer.name)
            name.setData(Qt.ItemDataRole.UserRole, timer)
            self.table.setItem(row, 0, name)
            self.table.setItem(row, 1, QTableWidgetItem(format_timestamp(timer.next_usec)))
            self.table.setItem(row, 2, QTableWidgetItem(format_timestamp(timer.last_usec)))
            self.table.setItem(row, 3, QTableWidgetItem(timer.unit_file_state))
            self.table.setItem(row, 4, QTableWidgetItem(timer.activates or "—"))
        self.table.setSortingEnabled(True)
        self.apply_filter()
        self.clear_busy(f"Loaded {len(self.timers)} {self.current_scope()} timers")

    def apply_filter(self) -> None:
        query = self.search.text().strip().casefold()
        requested_state = self.state_filter.currentText().casefold()
        for row in range(self.table.rowCount()):
            item = self.table.item(row, 0)
            timer = item.data(Qt.ItemDataRole.UserRole) if item else None
            if not isinstance(timer, TimerUnit):
                self.table.setRowHidden(row, True)
                continue
            text_match = not query or query in f"{timer.name} {timer.activates}".casefold()
            state_match = requested_state == "all states"
            if requested_state == "active":
                state_match = timer.active_state == "active"
            elif requested_state == "inactive":
                state_match = timer.active_state == "inactive"
            elif requested_state == "failed":
                state_match = timer.active_state == "failed"
            self.table.setRowHidden(row, not (text_match and state_match))

    def update_selection(self) -> None:
        timer = self.selected()
        busy = self.job is not None and self.job.isRunning()
        for action, button in self.action_buttons.items():
            enabled = timer is not None and not busy
            if action == "run-now" and timer is not None:
                enabled = enabled and bool(timer.activates)
            button.setEnabled(enabled)
        self.edit_schedule_button.setEnabled(timer is not None and not busy)
        self.restore_schedule_button.setEnabled(timer is not None and not busy)
        if timer is None:
            self.selected_timer.setText("Select a timer")
            self.selected_target.setText("—")
            self.selected_state.setText("—")
            self.command_preview.clear()
            return
        self.selected_timer.setText(timer.name)
        self.selected_target.setText(timer.activates or "No activated service reported")
        self.selected_state.setText(
            f"{timer.state_label}; startup: {timer.unit_file_state}"
        )
        self.command_preview.setText(
            display_command(self.current_scope(), "status", timer.name)
        )

    def edit_schedule(self) -> None:
        timer = self.selected()
        if timer is None:
            return
        scope = self.current_scope()

        def details_loaded(result: object) -> None:
            assert isinstance(result, TimerDetails)
            self.clear_busy(f"Loaded schedule details for {timer.name}")
            dialog = ScheduleDialog(timer, result, self)
            if dialog.exec() != QDialog.DialogCode.Accepted:
                return
            specification = dialog.specification
            if specification is None:
                return
            try:
                drop_in = schedule_drop_in(specification)
            except TaskShiftError as exc:
                QMessageBox.critical(self, TITLE, str(exc))
                return
            answer = QMessageBox.question(
                self,
                TITLE,
                "Apply this validated schedule override?\n\n"
                f"Timer: {timer.name}\nScope: {scope}\n\n{drop_in}\n"
                "Debian's original timer file will remain unchanged.",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel,
                QMessageBox.StandardButton.Cancel,
            )
            if answer != QMessageBox.StandardButton.Yes:
                return

            def applied(_: object) -> None:
                self.clear_busy(f"Updated schedule for {timer.name}")
                QTimer.singleShot(0, self.refresh)

            self.start_job(
                apply_schedule,
                (scope, timer, specification),
                f"Updating {timer.name}… KDE may request administrator authentication.",
                applied,
            )

        self.start_job(
            load_timer_details,
            (scope, timer.name),
            f"Reading the effective schedule for {timer.name}…",
            details_loaded,
        )

    def restore_original_schedule(self) -> None:
        timer = self.selected()
        if timer is None:
            return
        scope = self.current_scope()

        def details_loaded(result: object) -> None:
            assert isinstance(result, TimerDetails)
            self.clear_busy(f"Loaded schedule details for {timer.name}")
            if not result.taskshift_override:
                QMessageBox.information(
                    self,
                    TITLE,
                    "This timer has no active TaskShift schedule override. "
                    "Other administrator or package drop-ins were not changed.",
                )
                return
            answer = QMessageBox.question(
                self,
                TITLE,
                f"Restore the original effective schedule for {timer.name}?\n\n"
                "Only TaskShift's named drop-in will be neutralized. Debian's "
                "timer file and unrelated administrator drop-ins remain untouched.",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel,
                QMessageBox.StandardButton.Cancel,
            )
            if answer != QMessageBox.StandardButton.Yes:
                return

            def restored(_: object) -> None:
                self.clear_busy(f"Restored the original schedule for {timer.name}")
                QTimer.singleShot(0, self.refresh)

            self.start_job(
                restore_schedule,
                (scope, timer),
                f"Restoring {timer.name}… KDE may request administrator authentication.",
                restored,
            )

        self.start_job(
            load_timer_details,
            (scope, timer.name),
            f"Checking TaskShift's schedule override for {timer.name}…",
            details_loaded,
        )

    def run_action(self, action: str) -> None:
        timer = self.selected()
        if timer is None:
            return
        try:
            command = action_command(self.current_scope(), timer, action)
        except TaskShiftError as exc:
            QMessageBox.critical(self, TITLE, str(exc))
            return
        if action in {"stop", "disable", "run-now"}:
            consequences = {
                "stop": "Stopping a timer prevents its next scheduled run until it is started again.",
                "disable": "Disabling a timer changes whether it starts automatically.",
                "run-now": "Running the activated service now may perform updates, cleanup, or other work immediately.",
            }[action]
            answer = QMessageBox.question(
                self,
                TITLE,
                f"{consequences}\n\nRun this command?\n{command}",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel,
                QMessageBox.StandardButton.Cancel,
            )
            if answer != QMessageBox.StandardButton.Yes:
                return
        self.command_preview.setText(command)

        def completed(_: object) -> None:
            self.clear_busy(f"Completed: {command}")
            QTimer.singleShot(0, self.refresh)

        self.start_job(
            perform_action,
            (self.current_scope(), timer, action),
            f"Running {command}… KDE may request administrator authentication.",
            completed,
        )

    def closeEvent(self, event: QCloseEvent) -> None:
        if self.job is not None and self.job.isRunning():
            QMessageBox.information(
                self,
                TITLE,
                "A systemd request is still finishing. Close TaskShift when it completes.",
            )
            event.ignore()
            return
        super().closeEvent(event)


def main() -> int:
    if "--version" in sys.argv:
        print(f"{TITLE} {VERSION}")
        return 0
    application = qt_application()
    window = TaskWindow()
    window.show()
    return application.exec()


if __name__ == "__main__":
    raise SystemExit(main())
