TITLE = "TaskShift"
VERSION = "0.2.0"
SYSTEMCTL = "/usr/bin/systemctl"
SYSTEMD_ANALYZE = "/usr/bin/systemd-analyze"
PKEXEC = "/usr/bin/pkexec"
TASKSHIFT_DROP_IN = "50-task-shift.conf"
TIMER_PATTERN = re.compile(r"[A-Za-z0-9_.:@-]+\.timer")
SERVICE_PATTERN = re.compile(r"[A-Za-z0-9_.:@-]+\.service")
SCOPES = ("system", "user")
ACTIONS = ("start", "stop", "enable", "disable", "run-now")
_QT_APPLICATION: QApplication | None = None


class TaskShiftError(Exception):
    pass


@dataclass(frozen=True)
class TimerUnit:
    name: str
    activates: str
    next_usec: int
    last_usec: int
    active_state: str
    sub_state: str
    unit_file_state: str

    @property
    def state_label(self) -> str:
        if self.active_state == "active" and self.sub_state:
            return f"Active ({self.sub_state})"
        if self.active_state == "failed":
            return "Failed"
        if self.active_state:
            return self.active_state.capitalize()
        return "Not loaded"


@dataclass(frozen=True)
class TimerDetails:
    calendar: str
    monotonic: str
    persistent: bool
    randomized_delay: str
    accuracy: str
    taskshift_override: bool

    @property
    def schedule_summary(self) -> str:
        parts = [value for value in (self.calendar, self.monotonic) if value]
        return "\n".join(parts) if parts else "No active schedule expression reported."


@dataclass(frozen=True)
class ScheduleSpec:
    directive: str
    value: str
    persistent: bool = False
    exact: bool = False


def qt_application() -> QApplication:
    global _QT_APPLICATION
    application = QApplication.instance()
    if application is None:
        application = QApplication([sys.argv[0]])
        application.setApplicationName(TITLE)
        application.setApplicationDisplayName(TITLE)
        application.setDesktopFileName("task-shift")
        application.setWindowIcon(QIcon.fromTheme("view-calendar-tasks"))
    assert isinstance(application, QApplication)
    _QT_APPLICATION = application
    return application


def validate_scope(scope: str) -> str:
    if scope not in SCOPES:
        raise TaskShiftError("The timer scope is invalid.")
    return scope


def validate_timer_name(name: str) -> str:
    if name.startswith("-") or not TIMER_PATTERN.fullmatch(name):
        raise TaskShiftError("The selected timer name is invalid.")
    return name


def validate_service_name(name: str) -> str:
    if name.startswith("-") or not SERVICE_PATTERN.fullmatch(name):
        raise TaskShiftError("The timer does not expose a valid service to run.")
    return name


def systemctl_arguments(scope: str, *arguments: str) -> list[str]:
    validate_scope(scope)
    command = [SYSTEMCTL]
    if scope == "user":
        command.append("--user")
    command.extend(arguments)
    return command


def display_command(scope: str, *arguments: str) -> str:
    command = ["systemctl"]
    if validate_scope(scope) == "user":
        command.append("--user")
    command.extend(arguments)
    return shlex.join(command)


def run_systemctl(scope: str, *arguments: str) -> str:
    environment = os.environ.copy()
    environment.update(
        {
            "LC_ALL": "C",
            "SYSTEMD_PAGER": "",
            "SYSTEMD_LESS": "",
        }
    )
    try:
        result = subprocess.run(
            systemctl_arguments(scope, *arguments),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=30,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TaskShiftError(f"systemctl could not complete: {exc}") from exc
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        raise TaskShiftError(message or "systemctl did not complete successfully.")
    return result.stdout


def systemctl_edit_arguments(scope: str, unit_name: str) -> list[str]:
    validate_scope(scope)
    validate_timer_name(unit_name)
    command = [SYSTEMCTL]
    if scope == "system":
        command.insert(0, PKEXEC)
    else:
        command.append("--user")
    command.extend(
        ("edit", f"--drop-in={TASKSHIFT_DROP_IN}", "--stdin", unit_name)
    )
    return command


def write_schedule_drop_in(scope: str, unit_name: str, contents: str) -> None:
    validate_scope(scope)
    validate_timer_name(unit_name)
    if len(contents.encode("utf-8")) > 4096 or "\x00" in contents:
        raise TaskShiftError("The generated schedule override is invalid.")
    environment = os.environ.copy()
    environment.update({"LC_ALL": "C", "SYSTEMD_PAGER": ""})
    try:
        result = subprocess.run(
            systemctl_edit_arguments(scope, unit_name),
            input=contents,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=180,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TaskShiftError(f"The schedule override could not be written: {exc}") from exc
    if result.returncode != 0:
        if result.returncode in {126, 127}:
            raise TaskShiftError("Administrator authentication was cancelled.")
        message = result.stderr.strip() or result.stdout.strip()
        raise TaskShiftError(message or "The schedule override was not accepted.")


def validate_calendar(expression: str) -> tuple[str, str]:
    expression = expression.strip()
    if (
        not expression
        or len(expression) > 512
        or any(character in expression for character in ("\n", "\r", "\x00"))
    ):
        raise TaskShiftError("Enter one valid systemd calendar expression.")
    environment = os.environ.copy()
    environment["LC_ALL"] = "C"
    try:
        result = subprocess.run(
            [SYSTEMD_ANALYZE, "calendar", "--iterations=3", "--", expression],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=10,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TaskShiftError(f"The calendar expression could not be checked: {exc}") from exc
    if result.returncode != 0:
        message = result.stderr.strip() or "systemd rejected the calendar expression."
        raise TaskShiftError(message)
    match = re.search(r"^Normalized form:\s*(.+)$", result.stdout, re.MULTILINE)
    normalized = match.group(1).strip() if match else expression
    return normalized, result.stdout.strip()


def schedule_drop_in(specification: ScheduleSpec) -> str:
    lines = ["# Managed by TaskShift: active", "[Timer]", "OnCalendar="]
    if specification.directive == "OnCalendar":
        normalized, _ = validate_calendar(specification.value)
        lines.append(f"OnCalendar={normalized}")
        lines.append(f"Persistent={'yes' if specification.persistent else 'no'}")
    elif specification.directive == "OnUnitActiveSec":
        if not re.fullmatch(r"[1-9][0-9]{0,5}min", specification.value):
            raise TaskShiftError("The repeat interval is invalid.")
        minutes = int(specification.value.removesuffix("min"))
        if not 1 <= minutes <= 10080:
            raise TaskShiftError("Choose an interval from 1 minute through 7 days.")
        lines.extend(
            (
                f"OnActiveSec={minutes}min",
                f"OnUnitActiveSec={minutes}min",
            )
        )
    else:
        raise TaskShiftError("The requested schedule type is not allowed.")
    if specification.exact:
        lines.extend(("RandomizedDelaySec=0", "AccuracySec=1s"))
    return "\n".join(lines) + "\n"


def restored_drop_in() -> str:
    return (
        "# Managed by TaskShift: restored\n"
        "# This no-op drop-in preserves the original timer schedule.\n"
        "[Timer]\n"
    )


def apply_schedule(scope: str, timer: TimerUnit, specification: ScheduleSpec) -> None:
    validate_timer_name(timer.name)
    write_schedule_drop_in(scope, timer.name, schedule_drop_in(specification))
    run_systemctl(scope, "try-restart", timer.name)


def restore_schedule(scope: str, timer: TimerUnit) -> None:
    validate_timer_name(timer.name)
    write_schedule_drop_in(scope, timer.name, restored_drop_in())
    run_systemctl(scope, "try-restart", timer.name)


def humanize_timer_property(value: str) -> str:
    return (
        value.replace("{ ", "")
        .replace(" }", "")
        .replace(" ; next_elapse=", " → next ")
        .strip()
    )


def load_timer_details(scope: str, unit_name: str) -> TimerDetails:
    validate_timer_name(unit_name)
    output = run_systemctl(
        scope,
        "show",
        unit_name,
        "--no-pager",
        "--property=TimersCalendar,TimersMonotonic,Persistent,RandomizedDelayUSec,AccuracyUSec,DropInPaths",
    )
    values: dict[str, str] = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key] = value
    managed = False
    for path_text in values.get("DropInPaths", "").split():
        if not path_text.endswith(f"/{TASKSHIFT_DROP_IN}"):
            continue
        try:
            contents = Path(path_text).read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        managed = "# Managed by TaskShift: active" in contents
    return TimerDetails(
        calendar=humanize_timer_property(values.get("TimersCalendar", "")),
        monotonic=humanize_timer_property(values.get("TimersMonotonic", "")),
        persistent=values.get("Persistent", "no") == "yes",
        randomized_delay=values.get("RandomizedDelayUSec", "unknown"),
        accuracy=values.get("AccuracyUSec", "unknown"),
        taskshift_override=managed,
    )


def microseconds(value: object) -> int:
    try:
        parsed = int(value)
    except (TypeError, ValueError):
        return 0
    return parsed if parsed > 0 else 0


def format_timestamp(value: int) -> str:
    if value <= 0:
        return "—"
    try:
        moment = datetime.fromtimestamp(value / 1_000_000).astimezone()
    except (OverflowError, OSError, ValueError):
        return "—"
    return moment.strftime("%Y-%m-%d %H:%M:%S %Z")


def parse_timers(
    schedule_text: str,
    units_text: str,
    files_text: str,
) -> list[TimerUnit]:
    try:
        schedule = json.loads(schedule_text)
        loaded = json.loads(units_text)
        files = json.loads(files_text)
    except (json.JSONDecodeError, TypeError) as exc:
        raise TaskShiftError("systemctl returned timer data in an unknown format.") from exc
    if not all(isinstance(value, list) for value in (schedule, loaded, files)):
        raise TaskShiftError("systemctl returned timer data in an unknown format.")

    timers: dict[str, dict[str, object]] = {}
    for record in schedule:
        if not isinstance(record, dict):
            continue
        name = str(record.get("unit", ""))
        if name.startswith("-") or not TIMER_PATTERN.fullmatch(name):
            continue
        activates = str(record.get("activates", ""))
        if activates and (
            activates.startswith("-") or not SERVICE_PATTERN.fullmatch(activates)
        ):
            activates = ""
        timers[name] = {
            "activates": activates,
            "next": microseconds(record.get("next")),
            "last": microseconds(record.get("last")),
            "active": "",
            "sub": "",
            "file": "",
        }

    for record in loaded:
        if not isinstance(record, dict):
            continue
        name = str(record.get("unit", ""))
        if name.startswith("-") or not TIMER_PATTERN.fullmatch(name):
            continue
        values = timers.setdefault(
            name,
            {
                "activates": "",
                "next": 0,
                "last": 0,
                "active": "",
                "sub": "",
                "file": "",
            },
        )
        values["active"] = str(record.get("active", ""))
        values["sub"] = str(record.get("sub", ""))

    for record in files:
        if not isinstance(record, dict):
            continue
        name = str(record.get("unit_file", ""))
        if (
            name.startswith("-")
            or not TIMER_PATTERN.fullmatch(name)
            or "@." in name
        ):
            continue
        values = timers.setdefault(
            name,
            {
                "activates": "",
                "next": 0,
                "last": 0,
                "active": "inactive",
                "sub": "dead",
                "file": "",
            },
        )
        values["file"] = str(record.get("state", ""))

    return [
        TimerUnit(
            name=name,
            activates=str(values["activates"]),
            next_usec=int(values["next"]),
            last_usec=int(values["last"]),
            active_state=str(values["active"]),
            sub_state=str(values["sub"]),
            unit_file_state=str(values["file"]) or "unknown",
        )
        for name, values in sorted(timers.items())
    ]


def load_timers(scope: str) -> list[TimerUnit]:
    schedule = run_systemctl(scope, "list-timers", "--all", "--no-pager", "--output=json")
    units = run_systemctl(
        scope,
        "list-units",
        "--type=timer",
        "--all",
        "--no-pager",
        "--output=json",
    )
    files = run_systemctl(
        scope,
        "list-unit-files",
        "--type=timer",
        "--no-pager",
        "--output=json",
    )
    return parse_timers(schedule, units, files)


def perform_action(scope: str, timer: TimerUnit, action: str) -> str:
    validate_scope(scope)
    validate_timer_name(timer.name)
    if action not in ACTIONS:
        raise TaskShiftError("The requested timer action is not allowed.")
    if action == "run-now":
        return run_systemctl(scope, "start", validate_service_name(timer.activates))
    return run_systemctl(scope, action, timer.name)


def action_command(scope: str, timer: TimerUnit, action: str) -> str:
    validate_timer_name(timer.name)
    if action == "run-now":
        return display_command(scope, "start", validate_service_name(timer.activates))
    if action not in ACTIONS:
        raise TaskShiftError("The requested timer action is not allowed.")
    return display_command(scope, action, timer.name)


class ScheduleDialog(QDialog):
    def __init__(self, timer: TimerUnit, details: TimerDetails, parent: QWidget) -> None:
        super().__init__(parent)
        self.timer = timer
        self.details = details
        self.specification: ScheduleSpec | None = None
        self.setWindowTitle(f"Edit schedule — {timer.name}")
        self.setMinimumWidth(680)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 18, 20, 16)
        layout.setSpacing(12)

        heading = QLabel(f"<b>Change when {timer.name} runs</b>")
        explanation = QLabel(
            "TaskShift creates one named systemd drop-in and leaves Debian's "
            "original timer file untouched. Restore original schedule neutralizes "
            "only the TaskShift drop-in."
        )
        explanation.setWordWrap(True)
        layout.addWidget(heading)
        layout.addWidget(explanation)

        current_group = QGroupBox("Current effective schedule")
        current_form = QFormLayout(current_group)
        current_form.setHorizontalSpacing(12)
        current_form.setVerticalSpacing(8)
        current_schedule = QLabel(details.schedule_summary)
        current_schedule.setWordWrap(True)
        current_schedule.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        current_form.addRow("Triggers:", current_schedule)
        current_form.addRow("Catch up missed runs:", QLabel("Yes" if details.persistent else "No"))
        current_form.addRow("Randomized delay:", QLabel(details.randomized_delay))
        current_form.addRow("Accuracy window:", QLabel(details.accuracy))
        layout.addWidget(current_group)

        schedule_group = QGroupBox("New schedule")
        schedule_layout = QVBoxLayout(schedule_group)
        schedule_layout.setSpacing(10)
        type_layout = QFormLayout()
        self.schedule_type = QComboBox()
        self.schedule_type.addItem("Daily", "daily")
        self.schedule_type.addItem("Weekly", "weekly")
        self.schedule_type.addItem("Monthly", "monthly")
        self.schedule_type.addItem("Repeat at an interval", "interval")
        self.schedule_type.addItem("Custom systemd calendar", "custom")
        type_layout.addRow("Schedule type:", self.schedule_type)
        schedule_layout.addLayout(type_layout)

        self.schedule_stack = QStackedWidget()

        daily_panel = QWidget()
        daily_form = QFormLayout(daily_panel)
        self.daily_time = QTimeEdit(QTime(9, 0))
        self.daily_time.setDisplayFormat("HH:mm")
        daily_form.addRow("Run every day at:", self.daily_time)
        self.schedule_stack.addWidget(daily_panel)

        weekly_panel = QWidget()
        weekly_form = QFormLayout(weekly_panel)
        self.weekday = QComboBox()
        for label, value in (
            ("Monday", "Mon"),
            ("Tuesday", "Tue"),
            ("Wednesday", "Wed"),
            ("Thursday", "Thu"),
            ("Friday", "Fri"),
            ("Saturday", "Sat"),
            ("Sunday", "Sun"),
        ):
            self.weekday.addItem(label, value)
        self.weekly_time = QTimeEdit(QTime(9, 0))
        self.weekly_time.setDisplayFormat("HH:mm")
        weekly_form.addRow("Day:", self.weekday)
        weekly_form.addRow("Time:", self.weekly_time)
        self.schedule_stack.addWidget(weekly_panel)

        monthly_panel = QWidget()
        monthly_form = QFormLayout(monthly_panel)
        self.month_day = QSpinBox()
        self.month_day.setRange(1, 31)
        self.month_day.setValue(1)
        self.monthly_time = QTimeEdit(QTime(9, 0))
        self.monthly_time.setDisplayFormat("HH:mm")
        monthly_form.addRow("Day of month:", self.month_day)
        monthly_form.addRow("Time:", self.monthly_time)
        self.schedule_stack.addWidget(monthly_panel)

        interval_panel = QWidget()
        interval_form = QFormLayout(interval_panel)
        self.interval_minutes = QSpinBox()
        self.interval_minutes.setRange(1, 10080)
        self.interval_minutes.setValue(60)
        self.interval_minutes.setSuffix(" minutes")
        interval_note = QLabel(
            "The first run occurs after this delay; later runs are measured from "
            "the activated unit's previous run."
        )
        interval_note.setWordWrap(True)
        interval_form.addRow("Repeat every:", self.interval_minutes)
        interval_form.addRow("", interval_note)
        self.schedule_stack.addWidget(interval_panel)

        custom_panel = QWidget()
        custom_form = QFormLayout(custom_panel)
        self.custom_calendar = QLineEdit()
        self.custom_calendar.setPlaceholderText("For example: Mon..Fri *-*-* 09:00:00")
        custom_note = QLabel(
            "Custom input is passed only to systemd-analyze for validation and is "
            "never interpreted by a shell."
        )
        custom_note.setWordWrap(True)
        custom_form.addRow("OnCalendar:", self.custom_calendar)
        custom_form.addRow("", custom_note)
        self.schedule_stack.addWidget(custom_panel)
        schedule_layout.addWidget(self.schedule_stack)
        layout.addWidget(schedule_group)

        options_group = QGroupBox("Timing behavior")
        options_layout = QVBoxLayout(options_group)
        self.persistent = QCheckBox("Run one missed occurrence after the machine starts again")
        self.persistent.setChecked(details.persistent)
        self.exact = QCheckBox("Run as close as possible to the selected time")
        exact_note = QLabel(
            "When enabled, TaskShift sets RandomizedDelaySec=0 and AccuracySec=1s. "
            "Leave it off to preserve the timer's Debian-provided delay and accuracy settings."
        )
        exact_note.setWordWrap(True)
        options_layout.addWidget(self.persistent)
        options_layout.addWidget(self.exact)
        options_layout.addWidget(exact_note)
        layout.addWidget(options_group)

        preview_group = QGroupBox("Validated preview")
        preview_layout = QVBoxLayout(preview_group)
        self.expression_preview = QLineEdit()
        self.expression_preview.setReadOnly(True)
        self.next_runs = QLabel()
        self.next_runs.setWordWrap(True)
        self.next_runs.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        preview_layout.addWidget(self.expression_preview)
        preview_layout.addWidget(self.next_runs)
        layout.addWidget(preview_group)

        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Apply
            | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.button(QDialogButtonBox.StandardButton.Apply).setText("Apply schedule")
        buttons.button(QDialogButtonBox.StandardButton.Apply).clicked.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

        self.schedule_type.currentIndexChanged.connect(self.schedule_changed)
        self.daily_time.timeChanged.connect(self.update_preview)
        self.weekday.currentIndexChanged.connect(self.update_preview)
        self.weekly_time.timeChanged.connect(self.update_preview)
        self.month_day.valueChanged.connect(self.update_preview)
        self.monthly_time.timeChanged.connect(self.update_preview)
        self.interval_minutes.valueChanged.connect(self.update_preview)
        self.custom_calendar.textChanged.connect(self.update_preview)
        self.schedule_changed()

    @staticmethod
    def time_text(editor: QTimeEdit) -> str:
        return editor.time().toString("HH:mm")

    def values(self) -> ScheduleSpec:
        schedule_type = str(self.schedule_type.currentData())
        if schedule_type == "daily":
            value = f"*-*-* {self.time_text(self.daily_time)}:00"
        elif schedule_type == "weekly":
            value = (
                f"{self.weekday.currentData()} *-*-* "
                f"{self.time_text(self.weekly_time)}:00"
            )
        elif schedule_type == "monthly":
            value = (
                f"*-*-{self.month_day.value():02d} "
                f"{self.time_text(self.monthly_time)}:00"
            )
        elif schedule_type == "interval":
            return ScheduleSpec(
                "OnUnitActiveSec",
                f"{self.interval_minutes.value()}min",
                exact=self.exact.isChecked(),
            )
        elif schedule_type == "custom":
            value = self.custom_calendar.text()
        else:
            raise TaskShiftError("Choose a valid schedule type.")
        normalized, _ = validate_calendar(value)
        return ScheduleSpec(
            "OnCalendar",
            normalized,
            persistent=self.persistent.isChecked(),
            exact=self.exact.isChecked(),
        )

    def schedule_changed(self) -> None:
        self.schedule_stack.setCurrentIndex(self.schedule_type.currentIndex())
        is_calendar = self.schedule_type.currentData() != "interval"
        self.persistent.setEnabled(is_calendar)
        self.update_preview()

    def update_preview(self) -> None:
        try:
            specification = self.values()
            if specification.directive == "OnCalendar":
                normalized, preview = validate_calendar(specification.value)
                self.expression_preview.setText(f"OnCalendar={normalized}")
                self.next_runs.setText(preview)
            else:
                self.expression_preview.setText(
                    f"OnActiveSec={specification.value}; "
                    f"OnUnitActiveSec={specification.value}"
                )
                self.next_runs.setText(
                    "Monotonic interval: the timer runs after the selected delay "
                    "and repeats relative to activation."
                )
        except TaskShiftError as exc:
            self.expression_preview.clear()
            self.next_runs.setText(str(exc))

    def accept(self) -> None:
        try:
            self.specification = self.values()
        except TaskShiftError as exc:
            QMessageBox.critical(self, TITLE, str(exc))
            return
        super().accept()


class BackgroundJob(QThread):
    def __init__(self, function: Callable[..., object], *arguments: object) -> None:
        super().__init__()
        self.function = function
        self.arguments = arguments
        self.result: object | None = None
        self.error = ""

    def run(self) -> None:
        try:
            self.result = self.function(*self.arguments)
        except Exception as exc:
            self.error = str(exc)


class TaskWindow(QMainWindow):
    def __init__(self, *, autoload: bool = True) -> None:
        super().__init__()
        self.setWindowTitle(TITLE)
        self.setWindowIcon(QIcon.fromTheme("view-calendar-tasks"))
        self.setMinimumSize(980, 660)
        self.timers: list[TimerUnit] = []
        self.job: BackgroundJob | None = None

        central = QWidget()
        self.setCentralWidget(central)
        self.main_layout = QVBoxLayout(central)
