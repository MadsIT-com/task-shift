[Desktop Entry]
Type=Application
Name=TaskShift
GenericName=Systemd Timer Manager
Comment=Manage Debian scheduled tasks through a familiar KDE interface
Exec=@TASK_SHIFT_EXEC@
Icon=view-calendar-tasks
Terminal=false
